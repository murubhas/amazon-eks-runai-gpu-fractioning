# Copy this file to walkthrough.env and change only the values you need.
AWS_REGION=us-east-2
CLUSTER_NAME=runai-fractioning-blog
EKS_VERSION=1.36
GPU_INSTANCE_TYPE=g5.xlarge
NVIDIA_DRIVER_VERSION=615.71.09
GPU_OPERATOR_VERSION=v26.7.1
KAI_VERSION=v0.18.5

# Authentication option 1: named AWS CLI or IAM Identity Center profile.
# AWS_PROFILE=my-profile

# Authentication option 2: AWS access keys. Leave AWS_PROFILE unset when using
# these variables. AWS_SESSION_TOKEN is required only for temporary credentials.
# Keep real values only in the ignored walkthrough.env file and never commit it.
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN

# Optional: pin approved infrastructure instead of automatic discovery.
# SOURCE_AMI_ID=ami-id-from-approved-image
# PACKER_SUBNET_ID=subnet-id-in-cluster-vpc
